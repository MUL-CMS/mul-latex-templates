\ProvidesPackage{calendar}
\RequirePackage{ifthen,forloop,xcolor}

\newcounter{day}
\setcounter{day}{0}
\newcounter{dayOfWeek}
\newcounter{week}
\newcommand{\colorWeekend}{\color{gray}}
\newcommand{\colorMonthName}{\color{red!80!black}}

\newcommand{\calendar}[4]{
\setcounter{day}{0}
\begin{tabular}{*{7}{@{}c@{}}}
  \multicolumn{7}{c}{\colorMonthName #2}\\\hline
  \parbox{#1}{\centering Mon} & \parbox{#1}{\centering Tue} & \parbox{#1}{\centering Wed} & \parbox{#1}{\centering Thu} & \parbox{#1}{\centering Fri} & \parbox{#1}{\centering\colorWeekend Sat} & \parbox{#1}{\centering\colorWeekend Sun} \\\hline

  \forLoop[1]{2}{#4}{dayOfWeek}{&}
  \forLoop[1]{#4}{6}{dayOfWeek}{\stepcounter{day}\ifthenelse{\value{dayOfWeek}>5}{\colorWeekend}{}\theday&}\stepcounter{day}{\colorWeekend\theday}\\

  \forLoop[1]{1}{5}{week}{
    \forLoop[1]{1}{6}{dayOfWeek}{\stepcounter{day}\ifthenelse{\value{day}>#3}{}{\ifthenelse{\value{dayOfWeek}>5}{\colorWeekend}{}\theday&}}
    \stepcounter{day}\ifthenelse{\value{day}>#3}{}{{\colorWeekend\theday}}\ifthenelse{\value{day}<#3}{\\}{\\}
  }

  \end{tabular}
}