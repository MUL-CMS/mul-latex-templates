% Package dh_physics.cls
% (c) 2007 David Holec
%
% This package simplifies typesetting of units of physical variables
% and introduced other useful physics-related stuff
\ProvidesPackage{dh_physics}[2007/04/11 v0.1 David's package for typesetting physics.]
%
%
% Verbosity of the package
\newcounter{dh_physics@verbose}%
\DeclareOption{verbose}{\setcounter{dh_physics@verbose}{1}}%
\DeclareOption{silent}{\setcounter{dh_physics@verbose}{0}}%
%
% implicit options: silent
\ExecuteOptions{silent}%
\ProcessOptions%
%
%
% it requires the ifthen.sty package for logical operations
\RequirePackage{ifthen}%
%
%
% units are typeset in upshape roman font with small space preceding them
\ifthenelse{\isundefined{\uu}}%
 {\newcommand{\uu}[1]{\ensuremath{\,\text{#1}}}}%
 {\ifthenelse{\value{dh_physics@verbose}=0}%
  {\relax}%
  {\PackageWarning{dh_physics}{Redefining command \noexpand\u}}%
  \renewcommand{\uu}[1]{\ensuremath{\,\text{#1}}}%
 }%
%
%
% crystalographic directions and planes; minus as overlining the symbol
\newcommand{\dir}[1]{[ #1]}%
\newcommand{\Dir}[1]{\langle #1 \rangle}%
\newcommand{\plane}[1]{( #1 )}%
\newcommand{\Plane}[1]{\{ #1 \}}%
\newcommand{\minus}[1]{\overline{#1}}%
%
%
% degree symbol
\newcommand{\degree}{^{\circ}}%
\renewcommand{\deg}{\degree}
%
%
\endinput
%
% end of dh_physics.sty
%%%%%%%%%%%%%%%%%%%%%%%