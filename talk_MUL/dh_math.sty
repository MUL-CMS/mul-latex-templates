\ProvidesPackage{dh_math}[2007/04/11 v0.1 David's package for typesetting mathematics.]
%
%
% Verbosity of the package
\newcounter{dh_math@verbose}%
\DeclareOption{verbose}{\setcounter{dh_math@verbose}{1}}%
\DeclareOption{silent}{\setcounter{dh_math@verbose}{0}}%
%
% implicit options: silent
\ExecuteOptions{silent}%
\ProcessOptions%
%
% it requires the ifthen.sty package for logical operations
\RequirePackage{ifthen,bm}%
%
%
% derivative and partial derivative
\newcommand{\p}{\partial}%
\ifthenelse{\isundefined{\d}}%
 {\newcommand{\d}{\mbox{d}}}%
 {\ifthenelse{\value{dh_math@verbose}=0}%
  {\relax}%
  {\PackageWarning{dh_math}{Redefining command \noexpand\d}}%
  \renewcommand{\d}{\mbox{d}}%
 }%
\newcommand{\pderiv}[3][]{%
 \ifthenelse{\equal{#1}{}}%
 {\frac{\p #2}{\p #3}}%
 {\frac{\p^#1 #2}{\p #3^#1}}%
}%
\newcommand{\deriv}[3][]{%
 \ifthenelse{\equal{#1}{}}%
 {\frac{\d #2}{\d #3}}%
 {\frac{\d^#1 #2}{\d #3^#1}}%
}%
%
%
% the sign function
\newcommand{\sgn}{\mathop{\rm sgn}}%
%
%
% complex numbers
\newcommand{\I}{\mathrm{i}}%
 \newcommand{\e}{\mathrm{e}}%
\renewcommand{\Re}{\mathop{\mathrm{Re}}}%
\renewcommand{\Im}{\mathop{\mathrm{Im}}}%
%
%
% caligraphical symbols
\newcommand{\E}{{\cal E}}%
%
%
% general abbreviations
\newcommand{\eps}{\varepsilon}%
\newcommand{\vph}{\varphi}%
\newcommand{\Beps}{\Bvarepsilon}%
%
%
% easier brackets
\renewcommand{\(}{\left(}%
\renewcommand{\)}{\right)}%
\renewcommand{\[}{\left[}%
\renewcommand{\]}{\right]}%
%
%
% fractions from Yeti
\newcommand\fracd{\@ifstar\@fracds\@fracd}
\newcommand\@fracd[2]{{\displaystyle{#1\over#2}}}
\newcommand\@fracds[2]{{\displaystyle{\strut#1\over\strut#2}}}
